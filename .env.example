# Membership & Entitlements (Optional)
PATREON_URL=https://patreon.bybaoge.com/
PATREON_ROLE_ID=1526914848020234431

# Spotify Web API (Optional - recommended for ISRC matching & full metadata)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# KKBOX API (Optional - required for full KKBOX song metadata)
KKBOX_CLIENT_ID=
KKBOX_CLIENT_SECRET=
KKBOX_COOKIE=

# Lavalink External Audio Node (Recommended - hybrid engine with FFmpeg fallback)
LAVALINK_ENABLED=true
# Use http://lavalink:2333 when running via Docker Compose
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_YT_DIRECT_HTTP=1

# Internal AudioBridge (Streams StreetVoice/Bilibili OGG/Opus to Lavalink)
AUDIO_BRIDGE_HOST=0.0.0.0
AUDIO_BRIDGE_PORT=8765
AUDIO_BRIDGE_PUBLIC_URL=

# Development Options
FORCE_SYNC_COMMANDS=0
ENABLE_AUTO_RELOAD=0
ENABLE_BILI_FALLBACK=0
